# ==============================================================================
# ReLoop Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Mode Toggle: Set to 'true' for local testing without Google Cloud credentials.
# Set to 'false' to enable live Vertex AI, Firestore, GCS, Pub/Sub, and BigQuery.
DEMO_MODE=true

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Path to service account key file (if not using gcloud ADC on localhost)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# 1. Gemini on Vertex AI
# Model ID is configurable (e.g. gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL_ID=gemini-1.5-flash
# Optional: GEMINI_API_KEY if testing with direct Google AI Studio key
# GEMINI_API_KEY=AIzaSy...

# 2. Cloud Storage
GCS_BUCKET_NAME=reloop-item-assessments-bucket

# 3. Cloud Pub/Sub
PUBSUB_TOPIC_NAME=reloop-outcomes-topic

# 4. BigQuery Analytics
BIGQUERY_DATASET=reloop_analytics
BIGQUERY_TABLE=outcome_events_raw

# 5. Google Maps Platform (Client-side)
# Restrict this API key in Google Cloud Console by HTTP referrer and Maps JS API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 6. Firebase Authentication (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id

# 7. Firebase Admin (Server-side)
FIREBASE_PROJECT_ID=your-gcp-project-id
