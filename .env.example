# ==============================================================================
# ReLoop Bengaluru Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit secrets or .env.local.
# ==============================================================================

# Mode Toggle: Set to 'true' for local testing without Google Cloud credentials.
# Set to 'false' to enable live Vertex AI, Firestore, GCS, Pub/Sub, and BigQuery.
DEMO_MODE=true

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Path to service account key file (if not using gcloud auth application-default login on localhost)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# 1. Gemini on Vertex AI
# Model ID is configurable. Default verified model: gemini-2.5-flash
GEMINI_MODEL_ID=gemini-2.5-flash
# Optional: GEMINI_API_KEY for direct Gemini Developer API key if not using Vertex AI ADC
# GEMINI_API_KEY=AIzaSy...

# 2. Cloud Storage
GCS_BUCKET_NAME=reloop-item-assessments-bucket

# 3. Cloud Pub/Sub
PUBSUB_TOPIC_NAME=reloop-outcomes-topic

# 4. BigQuery Analytics
BIGQUERY_DATASET=reloop_analytics
BIGQUERY_TABLE=outcome_events

# 5. Google Maps Platform
# Server-side API key for Google Places Nearby & Autocomplete (restrict by IP or leave unrestricted to backend)
GOOGLE_MAPS_API_KEY=
# Client-side API key for Maps JavaScript SDK (restrict by HTTP Referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 6. Firebase Authentication (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id

# 7. Firebase Admin (Server-side)
FIREBASE_PROJECT_ID=your-gcp-project-id
